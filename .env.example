# Database
DATABASE_URL=postgresql://forge:forge@localhost:5432/forge

# Weights & Biases (free for personal use)
WANDB_API_KEY=your_wandb_key

# AWS S3 (for artifact storage)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=forge-artifacts

# OpenAI (for embeddings + agent)
OPENAI_API_KEY=your_openai_key

# Anthropic (for LangChain agent)
ANTHROPIC_API_KEY=your_anthropic_key

# --- added by Doppler migration: secrets ---
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
AGENT_API_KEY=your-agent-api-key
# --- non-secret config (safe defaults) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
CORS_ORIGINS=http://localhost:3000
PORT=8000
